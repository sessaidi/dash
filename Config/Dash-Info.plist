<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Kubernetes clusters (GKE and others) serve certificates from their own CA, which Dash
	     checks itself against the cluster's CA from the kubeconfig or the GKE API. App Transport
	     Security would block those connections before that check runs, so it is relaxed here;
	     every connection Dash makes is HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
